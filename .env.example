# Names only. Never put real values here. Copy to .env.local (git-ignored) and fill it there.

# Database: Neon Postgres. Use the pooled string for the app and the direct one for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# AI step (server only, never exposed to the browser).
# AI_PROVIDER is "openrouter" (Gemini models through OpenRouter) or "mock" (offline, deterministic).
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=google/gemini-3.8-flash

# Sessions: 32+ random bytes.
AUTH_SECRET=

# There are no passwords. People pick a role, and only while this is exactly "true".
# With it off nobody can start a session. Anyone with the link can act as any role while it is on.
OPEN_ACCESS_DEMO=false

# Base URL used in email links.
APP_URL=http://localhost:3000

# Email: only the "console" provider exists (messages are logged to the email_outbox table).
EMAIL_PROVIDER=console

# Bearer token required by the daily Kill 2 cron route.
CRON_SECRET=

# HubSpot: each pending buying decision becomes one deal when procurement clicks "Send to HubSpot".
# Token needs permission to create deals (HubSpot does not state the exact scope name in its docs).
HUBSPOT_ACCESS_TOKEN=
# Optional internal ids. HubSpot uses its default pipeline if omitted; set a stage if deals are rejected without one.
HUBSPOT_PIPELINE=
HUBSPOT_DEAL_STAGE=
